<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.system.mapper.OrderItemMapper">
    
    <resultMap id="OrderItemMap" type="com.system.entity.OrderItem">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="price" column="price"/>
    </resultMap>
    
    <select id="findByOrderId" parameterType="string" resultMap="OrderItemMap">
        SELECT * FROM order_items WHERE order_id = #{orderId}
    </select>
    
    <insert id="insert" parameterType="com.system.entity.OrderItem">
        INSERT INTO order_items (order_id, product_id, quantity, price)
        VALUES (#{orderId}, #{productId}, #{quantity}, #{price})
    </insert>
    
    <insert id="insertBatch" parameterType="map">
        INSERT INTO order_items (order_id, product_id, quantity, price)
        VALUES
        <foreach collection="orderItems" item="item" separator=",">
            (#{item.orderId}, #{item.productId}, #{item.quantity}, #{item.price})
        </foreach>
    </insert>
    
    <delete id="deleteByOrderId" parameterType="string">
        DELETE FROM order_items WHERE order_id = #{orderId}
    </delete>
    
</mapper>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.system.mapper.CategoryMapper">
    
    <resultMap id="CategoryMap" type="com.system.entity.Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="parentId" column="parent_id"/>
        <result property="sort" column="sort"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>
    
    <select id="findById" parameterType="int" resultMap="CategoryMap">
        SELECT * FROM categories WHERE id = #{id}
    </select>
    
    <select id="findAll" resultMap="CategoryMap">
        SELECT * FROM categories ORDER BY sort ASC
    </select>
    
    <select id="findByParentId" parameterType="int" resultMap="CategoryMap">
        SELECT * FROM categories WHERE parent_id = #{parentId} ORDER BY sort ASC
    </select>
    
    <select id="findAllWithChildren" resultMap="CategoryMap">
        SELECT * FROM categories ORDER BY parent_id ASC, sort ASC
    </select>
    
    <insert id="insert" parameterType="com.system.entity.Category" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (name, parent_id, sort, created_at)
        VALUES (#{name}, #{parentId}, #{sort}, NOW())
    </insert>
    
    <update id="update" parameterType="com.system.entity.Category">
        UPDATE categories
        SET name = #{name},
            parent_id = #{parentId},
            sort = #{sort}
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById" parameterType="int">
        DELETE FROM categories WHERE id = #{id}
    </delete>
    
</mapper>
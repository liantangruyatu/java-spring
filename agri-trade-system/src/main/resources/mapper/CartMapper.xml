<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.system.mapper.CartMapper">
    
    <resultMap id="CartMap" type="com.system.entity.Cart">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
    </resultMap>
    
    <select id="findByUserId" parameterType="int" resultMap="CartMap">
        SELECT * FROM cart WHERE user_id = #{userId}
    </select>
    
    <select id="findByUserIdAndProductId" parameterType="map" resultMap="CartMap">
        SELECT * FROM cart WHERE user_id = #{userId} AND product_id = #{productId}
    </select>
    
    <insert id="insert" parameterType="com.system.entity.Cart" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO cart (user_id, product_id, quantity)
        VALUES (#{userId}, #{productId}, #{quantity})
    </insert>
    
    <update id="updateQuantity" parameterType="map">
        UPDATE cart SET quantity = #{quantity} WHERE id = #{id}
    </update>
    
    <delete id="deleteById" parameterType="int">
        DELETE FROM cart WHERE id = #{id}
    </delete>
    
    <delete id="deleteByUserIdAndProductId" parameterType="map">
        DELETE FROM cart WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>
    
    <delete id="clearByUserId" parameterType="int">
        DELETE FROM cart WHERE user_id = #{userId}
    </delete>
    
</mapper>